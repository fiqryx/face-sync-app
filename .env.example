# ==========================================
# ENVIRONMENT & EXECUTION
# ==========================================
# linux: cuda (Nvidia GPU) or cpu | windows: cuda or directml (AMD/Intel GPU)
RUNTIME="cuda"
# Target OS: windows or linux
OS="linux"

# ==========================================
# CORE APPLICATION SETTINGS
# ==========================================
# App binding address (0.0.0.0 allows external network access)
HOST=0.0.0.0
# Main backend API port
PORT=8000
# Encryption key. LEAVE BLANK! The system will auto-generate and persist it
KEY=""
# Enable debugging mode (true/false)
DEBUG=false
# Enable detailed logging file (true/false)
LOG=false
# Application version
VERSION=1.5.0
# Path to store persistent data inside the container
STORAGE_PATH="/storage"

# ==========================================
# DATABASE (POSTGRESQL)
# ==========================================
# Note: If running entirely inside Docker Compose, change DB_HOST to your service name (e.g., "db" or "postgres")
DB_USERNAME="facesync"
DB_PASSWORD="secretpassword"
DB_HOST="127.0.0.1"
DB_PORT=5432
DB_NAME="facesync_db"
# Auto-constructed DB URL. Do not change unless using custom connection formats.
DATABASE_URL="postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=disable"

# ==========================================
# REDIS (CACHE / MESSAGE BROKER)
# ==========================================
# Note: If running inside Docker Compose, change REDIS_HOST to your service name (e.g., "redis")
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
# Set to 'true' if you want to bypass/disable Redis functionality
REDIS_IGNORE=false

# ==========================================
# MEDIAMTX (STREAMING SERVER)
# ==========================================
# Note: If running inside Docker Compose, change MEDIAMTX_HOST to your service name
MEDIAMTX_HOST="127.0.0.1"
# Auto-constructed URLs for MediaMTX services
MEDIAMTX_API="http://${MEDIAMTX_HOST}:9997"
MEDIAMTX_RTSP="rtsp://${MEDIAMTX_HOST}:8554"
MEDIAMTX_WEBRTC="http://${MEDIAMTX_HOST}:8889"
MEDIAMTX_HLS="http://${MEDIAMTX_HOST}:8888"

# ==========================================
# PIPER (TEXT-TO-SPEECH SERVICE)
# ==========================================
# Note: If running inside Docker Compose, change PIPER_HOST to your service name
PIPER_HOST="localhost"
PIPER_PORT=5500
# Auto-constructed URL for Piper TTS
PIPER_URL="http://${PIPER_HOST}:${PIPER_PORT}"

# ==========================================
# WEB UI (FRONTEND)
# ==========================================
# Exposed port for the frontend web interface
WEBUI_PORT=80